@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Authenticated User" as User
participant "Client UI" as UI
participant "BookService" as BookSvc
participant "PaymentService" as PaySvc
participant "Order" as Order
participant "Payment" as Payment
participant "Book" as Book
participant "External Payment Gateway" as Gateway

User -> UI: clickPayButton()
activate UI

UI -> BookSvc: reserveBooks(orderId)
activate BookSvc
BookSvc -> Book: increaseReservedQuantity(bookId)
activate Book
Book --> BookSvc: confirmed
deactivate Book
BookSvc --> UI: reserved successfully
deactivate BookSvc

UI -> PaySvc: initiatePayment(orderId)
activate PaySvc

PaySvc -> Order: getOrderStatus(orderId)
activate Order
Order --> PaySvc: return status = "PROCESSED"
deactivate Order

PaySvc -> Payment: checkExistingPayments(orderId)
activate Payment
Payment --> PaySvc: return no active payments
deactivate Payment

PaySvc -> Payment: createPaymentRecord(orderId, PENDING, totalAmount)
activate Payment
Payment --> PaySvc: return paymentId
deactivate Payment

PaySvc -> Gateway: requestTransaction(paymentId, totalAmount)
activate Gateway

alt Розгалуження помилок платіжного шлюзу
    Gateway --> PaySvc: return DECLINED
    deactivate Gateway
    
    PaySvc -> Payment: updatePaymentStatus(paymentId, DECLINED)
    activate Payment
    Payment --> PaySvc: confirmed
    deactivate Payment
    
    PaySvc -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> PaySvc: status = PROCESSED
    deactivate Order

else Альтернатива Б: Недостатньо коштів (INSUFFICIENT_FUNDS)
    Gateway --> PaySvc: return INSUFFICIENT_FUNDS
    
    PaySvc -> Payment: updatePaymentStatus(paymentId, INSUFFICIENT_FUNDS)
    activate Payment
    Payment --> PaySvc: confirmed
    deactivate Payment
    
    PaySvc -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> PaySvc: status = PROCESSED
    deactivate Order

else Альтернатива В: Технічний збій / Таймаут (UNKNOWN)
    Gateway --> PaySvc: return UNKNOWN
    
    PaySvc -> Payment: updatePaymentStatus(paymentId, UNKNOWN)
    activate Payment
    Payment --> PaySvc: confirmed
    deactivate Payment
    
    PaySvc -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> PaySvc: status = PROCESSED
    deactivate Order
end

PaySvc --> UI: errorResponse()
deactivate PaySvc

UI -> BookSvc: releaseReservedBooks(orderId)
activate BookSvc
BookSvc -> Book: decreaseReservedQuantity(bookId)
activate Book
Book --> BookSvc: confirmed (stockQuantity unchanged)
deactivate Book
BookSvc --> UI: reservation released
deactivate BookSvc

UI --> User: showDetailedDeclineReason()
deactivate UI

@enduml