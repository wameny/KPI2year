@startuml
autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Authenticated User" as User
participant "Client UI" as UI
participant "PaymentService" as Service
participant "Order" as Order
participant "Payment" as Payment
participant "External Payment Gateway" as Gateway

User -> UI: clickPayButton()
activate UI
UI -> Service: initiatePayment(orderId)
activate Service

Service -> Order: getOrderStatus(orderId)
activate Order
Order --> Service: return status = "PROCESSED"
deactivate Order

Service -> Payment: checkExistingPayments(orderId)
activate Payment
Payment --> Service: return no active payments
deactivate Payment

Service -> Payment: createPaymentRecord(orderId, PENDING, totalAmount)
activate Payment
Payment --> Service: return paymentId
deactivate Payment

Service -> Gateway: requestTransaction(paymentId, totalAmount)
activate Gateway

alt Альтернатива А: Відмова банку (Declined)
    Gateway --> Service: return DECLINED
    deactivate Gateway
    
    Service -> Payment: updatePaymentStatus(paymentId, DECLINED)
    activate Payment
    Payment --> Service: confirmed
    deactivate Payment
    
    Service -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> Service: status = PROCESSED
    deactivate Order
    
    Service --> UI: return errorResponse("DECLINED")

else Альтернатива Б: Недостатньо коштів (Insufficient Funds)
    Gateway --> Service: return INSUFFICIENT_FUNDS
    
    Service -> Payment: updatePaymentStatus(paymentId, FAILED)
    activate Payment
    Payment --> Service: confirmed
    deactivate Payment
    
    Service -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> Service: status = PROCESSED
    deactivate Order
    
    Service --> UI: return errorResponse("INSUFFICIENT_FUNDS")

else Альтернатива В: Технічний збій / Таймаут (Unknown)
    Gateway --> Service: return UNKNOWN / TIMEOUT
    
    Service -> Payment: updatePaymentStatus(paymentId, UNKNOWN)
    activate Payment
    Payment --> Service: confirmed
    deactivate Payment
    
    Service -> Order: keepOrderStatus(orderId, PROCESSED)
    activate Order
    Order --> Service: status = PROCESSED
    deactivate Order
    
    Service --> UI: return errorResponse("UNKNOWN")
end

deactivate Service
UI --> User: showDetailedDeclineReason()
deactivate UI

@enduml